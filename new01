        // Web Audio API Synthesizer (Zero external sound file dependencies)
        const SoundFX = {
            ctx: null,
            init() {
                if (!this.ctx) {
                    const AudioContext = window.AudioContext || window.webkitAudioContext;
                    this.ctx = new AudioContext();
                }
                if (this.ctx.state === 'suspended') {
                    this.ctx.resume();
                }
            },
            playTone(freq, type, duration, delay = 0, gainVal = 0.15) {
                try {
                    this.init();
                    setTimeout(() => {
                        const osc = this.ctx.createOscillator();
                        const gain = this.ctx.createGain();
                        osc.type = type;
                        osc.frequency.setValueAtTime(freq, this.ctx.currentTime);
                        
                        gain.gain.setValueAtTime(gainVal, this.ctx.currentTime);
                        gain.gain.exponentialRampToValueAtTime(0.0001, this.ctx.currentTime + duration);
                        
                        osc.connect(gain);
                        gain.connect(this.ctx.destination);
                        
                        osc.start();
                        osc.stop(this.ctx.currentTime + duration);
                    }, delay);
                } catch(e) {
                    console.warn("Audio Context blocked or unsupported.", e);
                }
            },
            click() {
                this.playTone(587.33, 'sine', 0.08); // D5
            },
            correct() {
                // Happy victorious fan-fare chime
                this.playTone(523.25, 'triangle', 0.15, 0);   // C5
                this.playTone(659.25, 'triangle', 0.15, 100); // E5
                this.playTone(783.99, 'triangle', 0.15, 200); // G5
                this.playTone(1046.50, 'triangle', 0.4, 300); // C6
            },
            wrong() {
                // Gentle disappointment tone
                this.playTone(220, 'sawtooth', 0.25, 0, 0.1);
                this.playTone(174.61, 'sawtooth', 0.35, 150, 0.1);
            },
            royalTrumpet() {
                // Royal fanfare
                this.playTone(392.00, 'triangle', 0.15, 0);   // G4
                this.playTone(523.25, 'triangle', 0.15, 150); // C5
                this.playTone(659.25, 'triangle', 0.15, 300); // E5
                this.playTone(783.99, 'triangle', 0.5, 450);  // G5
            },
            battleSound() {
                // Low rumbling drums tone
                this.playTone(110, 'sawtooth', 0.2, 0);
                this.playTone(130, 'square', 0.2, 100);
                this.playTone(90, 'sawtooth', 0.3, 200);
            },
            templeChime() {
                // Heavenly temple bell ring
                this.playTone(880.00, 'sine', 0.5, 0, 0.2);
                this.playTone(1318.51, 'sine', 0.7, 150, 0.15);
            }
        };

